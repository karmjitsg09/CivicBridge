# CivicBridge AI Environment Configuration

# Server Port
PORT=3001
NODE_ENV=development

# Google Gemini API Key (Backend only - NEVER expose to client)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend origin for CORS (in production, set to your Cloud Run URL or custom domain)
CLIENT_ORIGIN=http://localhost:5173
